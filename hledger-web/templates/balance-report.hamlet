$# (the pages' links are in the top menu, see default-layout.hamlet)
$# Each account on a row of its own, indented to its depth, with a chevron
$# before one that has accounts under it, which folds them (hledger.js).
$forall (acct, adisplay, aindent, abal) <- items
  <tr data-acct=#{acct} data-depth=#{aindent}
     :matchesAcctSelector acct:.inacct
     :hideEmpty && not (isInterestingAccount acct):.hide>
    <td .acct :not (isInterestingAccount acct):.empty>
      <div .ff-wrapper>
        $if hasSubAccounts acct
          <button type=button .tree-toggle aria-expanded=true aria-label=#{tr trs "Fold the accounts under this one"} data-collapse=#{tr trs "Fold the accounts under this one"} data-expand=#{tr trs "Unfold the accounts under this one"}>
        $else
          <span .tree-leaf aria-hidden="true">
        <a.acct-name href="@?{(registerR, [("q", replaceInacct qparam $ accountQuery acct)])}"
           title=#{tr trs "Show transactions affecting this account and subaccounts"}>
          ^{wholeAccountNameAsHtml adisplay}
        $if hasSubAccounts acct
          <a href="@?{(registerR, [("q", replaceInacct qparam $ accountOnlyQuery acct)])}" .only.hidden-sm.hidden-xs
             title=#{tr trs "Show transactions affecting this account but not subaccounts"}>#{tr trs "only"}
    <td .amount>
      $if mixedAmountLooksZero abal
        ^{mixedAmountAsHtml abal}
      $else
        <a href="@?{(registerR, [("q", replaceInacct qparam $ accountQuery acct)])}"
           title=#{tr trs "Show the transactions that make up this balance"}>
          ^{mixedAmountAsHtml abal}
<tr .total>
  <td>
  <td .amount>
    $if mixedAmountLooksZero total
      ^{mixedAmountAsHtml total}
    $else
      <a href="@?{totallink}" title=#{tr trs "Show the transactions that make up this total"}>
        ^{mixedAmountAsHtml total}
