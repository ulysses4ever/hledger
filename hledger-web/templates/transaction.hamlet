$# An entry's page: a card with how much, what for and when, the facts
$# under them, and Edit and Delete at the bottom, as the phone money apps
$# show an entry. Edit shows the add form filled from the entry, under the
$# card (the link reloads with edit=1; hledger.js shows it in place). The
$# entry's text as the file had it when the page was made travels with the
$# forms, so a change to the file meanwhile is noticed (TransactionR).
<div .transaction-page>
  <div .entry-view>
    <p .entry-view-amount .#{kindClass}>#{oneLine (esAmount es)}
    <p .entry-view-what>
      $maybe acc <- esAccount es
        <a href=@?{(RegisterR, [("q", accountQuery acc)])}>^{accountNameAsHtml acc}
        $if esMore es > 0
          <span .more title=_{HMsg "and other accounts"}>+#{esMore es}
      $nothing
        _{HMsg "Transfer"}
    <p .entry-view-date>#{dayWithWeekday (tdate t)}
    <dl .entry-view-facts>
      $forall (label, value) <- facts
        <dt>#{label}
        <dd>
          $case value
            $of Left acc
              <a href=@?{(RegisterR, [("q", accountQuery acc)])}>^{accountNameAsHtml acc}
            $of Right txt
              #{txt}
      $maybe (i, expr) <- mrule
        <dt>
          <span .recurring-mark aria-hidden="true">↻
          _{HMsg "Recurring"}
        <dd>
          <a href=@{RecurringRuleR i}>#{expr}
  <div .entry-actions>
    $if not editing
      <a .btn .btn-default .btn-lg .entry-edit-button href=@?{editLink}>
        <span .glyphicon .glyphicon-pencil aria-hidden="true">
        _{HMsg "Edit"}
    <form#deleteform action=@{TransactionR (tindex t)} method=POST data-confirm=_{HMsg "Delete this entry?"}>
      $maybe token <- mtoken
        <input type=hidden name=_token value=#{token}>
      <input type=hidden name=original value="#{original}">
      <input type=hidden name=action value=delete>
      <button type=submit .btn .btn-danger .btn-lg>
        <span .glyphicon .glyphicon-trash aria-hidden="true">
        _{HMsg "Delete"}
    <a .btn .btn-link .btn-lg href=@?{back}>_{HMsg "Back"}
  <form#addform.form.entry-edit-form action=@{TransactionR (tindex t)} method=POST enctype=#{enctype} data-editing :not editing:hidden>
    <h3 .entry-edit-heading>_{HMsg "Edit transaction"}
    <input type=hidden name=original value="#{original}">
    ^{view}
