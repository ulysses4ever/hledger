^{extra}

<div .row>
  <div .col-md-3.col-sm-5.col-xs-12 :isJust (fvErrors dateView):.has-error>
    $# The date field stays a text input so that hledger's smart dates
    $# ("today", "2/15") still work. The button opens the browser's own date
    $# picker: an unseen date input lies over the button (see hledger.css),
    $# so a tap on the button is a tap on the real control, which every
    $# phone browser answers with its picker; what is picked is written
    $# back as an iso date (hledger.js).
    <div #dateWrap .form-group.input-group.date>
      ^{fvInput dateView}
      <div #datebutton .input-group-addon title=_{HMsg "Pick a date"}>
        <span .glyphicon .glyphicon-calendar>
        <input #datepicked type=date aria-label=_{HMsg "Pick a date"}>
    $maybe err <- fvErrors dateView
      <span .help-block .error-block>#{err}
  <div .col-md-9.col-sm-7.col-xs-12 :isJust (fvErrors descView):.has-error>
    <div .form-group>
      ^{fvInput descView}
    $maybe err <- fvErrors descView
      <span .help-block .error-block>#{err}
$# A free note, kept after the payee in the description ("Payee | note").
<div .row>
  <div .col-xs-12>
    <div .form-group>
      ^{fvInput noteView}
$# The status: unmarked, pending (!) or cleared (*). A new entry is unmarked;
$# the field shows only when editing, where confirming an entry means something.
<div .row .status-row :not editing:.hidden>
  <div .col-sm-3.col-xs-6>
    <div .form-group>
      ^{fvInput statusView}

$# What the entry is - an expense, income, or a transfer between accounts -
$# narrows the category list to that kind (hledger.js); the choice is kept
$# in a cookie. On a transfer the rows are the accounts paid to and from.
<div .row .kind-row>
  <div .col-xs-12>
    <div .btn-group .kind-select role=group aria-label=_{HMsg "Kind of entry"}
         data-to=_{HMsg "To account"} data-from=_{HMsg "From account"}
         data-subcategory=_{HMsg "Subcategory"} data-account=#{accountLabel 2}>
      <button type=button .btn .btn-default .kind-option data-kind=expenses>_{HMsg "Expense"}
      <button type=button .btn .btn-default .kind-option data-kind=income>_{HMsg "Income"}
      <button type=button .btn .btn-default .kind-option data-kind=transfer>_{HMsg "Transfer"}

$# The placeholder templates are also read by hledger.js when it adds rows.
<div .account-postings data-account-placeholder=#{accountPlaceholder} data-amount-placeholder=#{amountPlaceholder}>
  $forall (n, (acc, amt, cmdty, accE, amtE)) <- displayRows
    <div .form-group .row .account-group>
      $# Lists to pick from, rather than fields to type in: on a phone typing
      $# an account name is the hard part of an entry, and the books accept
      $# no new accounts anyway. The first row picks a category, then an
      $# account within it (hledger.js narrows the second list to the
      $# category; until one is picked it lists every account). The second
      $# row starts on the account the books use most, and hledger.js keeps
      $# each browser's last choices (see addformFocus).
      $if n == 1
        <div .col-xs-12>
          <select .category-select.form-control.input-lg data-row=#{n} aria-label=_{HMsg "Category"}>
            <option value="" selected>_{HMsg "Category"}
            $forall (kind, grp, cats) <- categoryGroups
              <optgroup label=#{grp} data-kind=#{kind}>
                $forall (key, label, _) <- cats
                  <option value=#{key}>#{label}
      <div .col-sm-9.col-xs-7 :isJust accE:.has-error>
        <select .account-input.form-control.input-lg name=account data-row=#{n}>
          $if n == 1
            <option value="" :T.null (chosen n acc):selected>_{HMsg "Subcategory"}
            $forall (_, _, cats) <- categoryGroups
              $forall (key, _, items) <- cats
                $forall (v, l) <- items
                  <option value=#{v} data-category=#{key} :v == chosen n acc:selected>#{l}
          $else
            <option value="" :T.null (chosen n acc):selected>#{accountLabel n}
            $forall (grp, opts) <- accountGroupsFor n
              <optgroup label=#{grp}>
                $forall (v, l) <- opts
                  <option value=#{v} :v == chosen n acc:selected>#{l}
        $maybe err <- accE
          <span .help-block .error-block>_{err}
      $# The amount, with the currency it is in picked beside it when the
      $# books hold more than one. The last row's amount is left to hledger
      $# (see hledger.css), so a two-row entry is one account, one amount,
      $# and the account it comes from. Another row shows it again.
      <div .col-sm-3.col-xs-5 :isJust amtE:.has-error>
        <div .amount-with-currency>
          $if length commodities <= 1
            <input type=hidden name=commodity value=#{defaultCommodity}>
          <input .amount-input.form-control.input-lg type=text
            name=amount placeholder=#{amountLabel n} value="#{amt}">
          $if length commodities > 1
            <select .currency-select.form-control.input-lg name=commodity aria-label=_{HMsg "Currency"}>
              $forall c <- commodities
                <option value=#{c} :c == pickedCommodity cmdty:selected>#{commodityLabel c}
        $maybe err <- amtE
          <span .help-block .error-block>_{err}
<div .add-row>
  <button type=button #addrow .btn .btn-default>_{HMsg "Add a row"}

<div .row>
  <div .col-sm-9.col-xs-7>
    $# New entries go to the journal's main file. A chooser for another of
    $# its files only confused, so it is kept out of sight; the form still
    $# says which file.
    $if length files > 1
      <div .form-group .file-select .hidden :isJust (fvErrors fileView):.has-error>
        ^{fvInput fileView}
        $maybe err <- fvErrors fileView
          <span .help-block .error-block>#{err}
  <div .col-sm-3.col-xs-5.text-right>
    <button type=submit .btn .btn-default .btn-lg name=submit>_{HMsg "Save"}

$# Completion data for the description field. The browser filters it itself,
$# so there is no javascript and no library involved, and hamlet's escaping
$# keeps journal text inert.
<datalist #descriptionnames>
  $forall desc <- toList descriptions
    <option value=#{desc}>
