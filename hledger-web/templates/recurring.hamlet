$# The recurring rules (RecurringR): each with its schedule, what it pays,
$# how much, between which accounts, and when it next falls; a link to add one.
<div .recurring-page>
  <h2>_{HMsg "Recurring rules"}
  <p .recurring-note>_{HMsg "Entries for the month are written ahead from these rules, pending until a statement confirms them. A rule changed here applies from its next date; entries already written stay until changed on their pages."}
  <p .recurring-actions>
    <a .btn .btn-default href=@{RecurringNewR}>
      <span .glyphicon .glyphicon-plus aria-hidden="true">
      _{HMsg "Add a rule"}
  $if null rows
    <p .recurring-empty>_{HMsg "No recurring rules yet."}
  $else
    <ul .recurring-list>
      $forall (i, _, schedule, mfrom, muntil, mnext, (payee, note), amount, accounts) <- rows
        <li>
          <a href=@{RecurringRuleR i}>
            <span .rule-payee>
              $if T.null payee
                _{HMsg "Transfer"}
              $else
                #{payee}
              $if not (T.null note)
                <span .rule-note> · #{note}
            <span .rule-amount>#{amount}
            <span .rule-schedule>
              #{schedule}
              $maybe from <- mfrom
                \ _{HMsg "from"} #{show from}
              $maybe until <- muntil
                \ _{HMsg "to"} #{show until}
            <span .rule-accounts>
              $forall (k, a) <- accounts
                $if k > 1
                  <span .sep aria-hidden="true"> ← #
                ^{accountNameAsHtml a}
            <span .rule-next>
              $maybe next <- mnext
                _{HMsg "Next"}: #{show next}
              $nothing
                _{HMsg "Nothing due in the coming year"}
