$# The page's parts, in a flex column (see hledger.css), so that a stylesheet
$# given with --css can rearrange them with the order property.
<div .journal-page>
  <div .journal-period>
    ^{periodBand trs JournalR qparam noParams today shown totals}

  <div .journal-actions>
    $if elem AddPermission perms
      <a #addformlink .btn .btn-default href=@{AddR} role="button"
         data-toggle="modal" data-target="#addmodal" title=_{HMsg "Add a new transaction to the journal"}>
        <span .glyphicon .glyphicon-plus aria-hidden="true">
        _{HMsg "Add a transaction"}
      <a .btn .btn-default .recurring-button href=@{RecurringR} role="button" title=_{HMsg "The recurring rules, from which entries are written ahead"}>
        <span .glyphicon .glyphicon-repeat aria-hidden="true">
        _{HMsg "Recurring"}
    $# An entry is shown single-sided unless this is ticked (see hledger.js).
    <label .both-sides-toggle title=_{HMsg "Show the accounts each entry's money came from on lines of their own, with their amounts"}>
      <input #bothsides type=checkbox :bothSides:checked>
      $# TRANSLATORS: a check box above the journal; ticked, each entry shows all its postings with their amounts.
      _{HMsg "Show both sides"}

  <div .journal-paging-top>
    ^{pagingLinks trs JournalR qparam page}

  <div .table-responsive .journal-entries>
    <table .transactionsreport .table .table-condensed :bothSides:.both-sides>
      <thead>
        <th .date>_{HMsgc "column heading" "Date"}
        <th .description>_{HMsgc "column heading" "Description"}
        $# three columns: where the money came from, the arrow, where it went;
        $# headed so, over the two accounts; both sides shown, one heading
        $if bothSides
          <th .account colspan=3>_{HMsgc "column heading" "Account"}
        $else
          <th .account .flow-from>_{HMsg "From"}
          <th .flow-arrow>
          <th .account .flow-to>_{HMsg "To"}
        <th .amount>_{HMsgc "column heading" "Amount"}

      $# Entries dated after today are folded away under this row, which
      $# hledger.js shows, and which shows them (they come first: newest first).
      $if futureCount > 0
        <tr .future-toggle hidden>
          <td colspan=6>
            <button type=button .btn .btn-link .future-button data-hide=_{HMsg "Hide the entries dated after today"}>#{trf trs "Show {n} entries dated after today" [("n", T.pack (show futureCount))]}
      $forall (torig, es) <- entries
        $# data-account and data-kind are for an instance stylesheet, to give
        $# the entry an icon (see the manual's "Customising the look").
        $# With add permission the row leads to the entry's page: a tap or
        $# click anywhere on it, through hledger.js (data-href), or on the
        $# description.
        <tr .title :isFuture torig:.future ##{transactionFrag torig} data-entry="#{showTransaction torig}"
            data-account="#{entryMainAccount es}" data-kind="#{entryKindClass (esKind es)}"
            :elem AddPermission perms:data-href=@{TransactionR (tindex torig)}>
          <td .date nowrap>
            <a href="@?{(JournalR, [("q", journalDayQuery qparam (tdate torig))])}##{transactionFrag torig}"
               title=_{HMsg "Show the journal entries on this date"}>
              #{show (tdate torig)}
          <td .description>
            $# the icon slot, filled by an instance stylesheet as the block's is
            <span .entry-icon aria-hidden="true">
            $if elem AddPermission perms
              <a .entry-link :T.null (tdescription torig):.entry-kind href=@{TransactionR (tindex torig)}>#{entryTitle torig es}
            $else
              <span :T.null (tdescription torig):.entry-kind>#{entryTitle torig es}
            $if isRecurring torig
              <span .recurring-mark title=_{HMsg "From a recurring rule"}>↻
          $# Single-sided, the entry sits on its title row: between two
          $# accounts, as where the money came from → where it went, and
          $# how much; with more accounts, its main posting (what it was
          $# for, and how much), the other postings keeping their rows
          $# below. Both sides shown, these cells hide instead (hledger.css).
          $maybe (src, dst) <- flowOf torig
            $# three cells, so the arrows line up down the page
            <td .account .main-posting .flow-from>
              <a href="@?{acctlink (paccount src) torig}##{transactionFrag torig}" title="#{paccount src}">
                ^{accountNameAsHtml (paccount src)}
            <td .main-posting .flow-arrow aria-hidden="true">→
            <td .account .main-posting .flow-to>
              <a href="@?{acctlink (paccount dst) torig}##{transactionFrag torig}" title="#{paccount dst}">
                ^{accountNameAsHtml (paccount dst)}
            <td .amount .main-posting>
              ^{mixedAmountAsHtml (pamount dst)}
          $nothing
            $maybe p <- mainPosting torig
              <td .account .main-posting colspan=3>
                <a href="@?{acctlink (paccount p) torig}##{transactionFrag torig}" title="#{paccount p}">
                  ^{accountNameAsHtml (paccount p)}
              <td .amount .main-posting>
                ^{mixedAmountAsHtml (pamount p)}
            $nothing
              <td .account .main-posting colspan=3>
              <td .amount .main-posting>
          $# On a phone, single-sided, the entry is shown as this block instead
          $# (hledger.css section 15): what it was for and how much; its date and
          $# where the money came from or went; its payee and note.
          <td .entry-card colspan=6>
            <span .entry-icon>
            <span .entry-what>
              $maybe acc <- esAccount es
                <a href="@?{acctlink acc torig}##{transactionFrag torig}" title="#{acc}">
                  ^{accountNameAsHtml acc}
                $if esMore es > 0
                  <span .more title=_{HMsg "and other accounts"}>+#{esMore es}
              $nothing
                $# TRANSLATORS: what a journal entry that moved money between two accounts is called, in place of a category.
                _{HMsg "Transfer"}
            <span .entry-amount .#{entryKindClass (esKind es)}>#{oneLine (esAmount es)}
            <span .entry-when-where>
              <a .entry-date href="@?{(JournalR, [("q", journalDayQuery qparam (tdate torig))])}##{transactionFrag torig}"
                 title=_{HMsg "Show the journal entries on this date"}>
                #{dayWithWeekday (tdate torig)}
              <span .entry-accounts>
                $forall acc <- lineFrom es
                  <a href="@?{acctlink acc torig}##{transactionFrag torig}" title="#{acc}">
                    ^{accountNameAsHtml acc}
                $# a transfer reads "bank › checking → bank › savings": the arrow
                $# says which way, and stays with the account it points to
                $forall acc <- lineTo es
                  <span .entry-to>
                    $if bothEnds es
                      <span .entry-label>→
                    <a href="@?{acctlink acc torig}##{transactionFrag torig}" title="#{acc}">
                      ^{accountNameAsHtml acc}
            <span .entry-memo>
              $if elem AddPermission perms
                <a .entry-link href=@{TransactionR (tindex torig)}>#{payeeAndNote torig}
              $else
                #{payeeAndNote torig}
              $if isRecurring torig
                <span .recurring-mark title=_{HMsg "From a recurring rule"}>↻

        $forall (p, isMain) <- postingRows torig
          <tr .posting :isSource (pamount p):.source :isMain:.main :isJust (flowOf torig):.flow :isFuture torig:.future>
            <td>
            <td>
            <td .account colspan=3>
              <a href="@?{acctlink (paccount p) torig}##{transactionFrag torig}" title="#{paccount p}">
                ^{accountNameAsHtml (paccount p)}
            <td .amount>
              ^{mixedAmountAsHtml (pamount p)}
        $# Single-sided, the postings whose amounts are all negative, where the
        $# money came from, are shown on this line instead, without amounts.
        $with sources <- sourceAccounts torig
          $if not (null sources)
            <tr .posting .from :isJust (flowOf torig):.flow :isFuture torig:.future>
              <td>
              <td>
              <td .from-accounts colspan=3>
                <span>
                  <span .from-label>
                    $# TRANSLATORS: begins a line naming the accounts a journal entry's money came from, eg "from bank › checking, cash".
                    _{HMsg "from"}
                  $forall (acc, comma) <- sources
                    <a href="@?{acctlink acc torig}##{transactionFrag torig}" title="#{acc}">
                      ^{accountNameAsHtml acc}</a>#{comma}
              <td .amount>

  <div .journal-paging-bottom>
    ^{pagingLinks trs JournalR qparam page}

$if elem AddPermission perms
  ^{addModal AddR j today Nothing}
