<h2 .account-heading>
  $maybe a <- headingAccount
    ^{accountNameAsHtml a}
  $nothing
    #{header}

$# An account's page, as phone money apps show one: its balance at the
$# end of the period, and under the period, the balance before it and
$# what was paid in and out during it (hledger.css section 17).
$if isAccountPage
  <div .account-balance .amount :isNegative endbal:.negative>#{oneLine endbal}

^{periodBand trs RegisterR qparam accumParams today shown noBelow}

$if isAccountPage
  <dl .account-summary>
    <dt>_{HMsg "Previous balance"}
    <dd .amount>#{oneLine prevbal}
    $# TRANSLATORS: on an account's page, the total of the money that came into it in the period shown.
    <dt>_{HMsg "Paid in"}
    <dd .amount .earning>#{oneLine paidin}
    $# TRANSLATORS: on an account's page, the total of the money that went out of it in the period shown.
    <dt>_{HMsg "Spent"}
    <dd .amount .spending>#{oneLine paidout}

^{pagingLinks trs RegisterR qparam page}

<div>
  ^{registerChartHtml qparam accumParams transactionFrag (T.unpack balancelabel) $ accountTransactionsReportByCommodity items}

<div.table-responsive>
  <table .registerreport.table.table-condensed>
    <thead>
      <tr>
        <th>
          _{HMsgc "column heading" "Date"}
          <span .glyphicon.glyphicon-chevron-up>
        <th>_{HMsgc "column heading" "Description"}
        <th>_{HMsgc "column heading" "To/From Account(s)"}
        <th .amount>_{HMsgc "column heading" "Amount Out/In"}
        <th .amount.balance>
          <a href=@?{accumToggle} title="#{accumToggleTitle}">#{balancelabel}

    <tbody>
      $forall (day, daytotal, dayitems) <- days
        $# On a phone, the rows are grouped by day, under a heading with the
        $# day's total; elsewhere it is hidden.
        <tr .day-heading>
          <td colspan=5>
            <span .day-date>#{dayWithWeekday day}
            <span .day-total .amount>#{oneLine daytotal}
        $forall (torig, tacct, split, _acct, amt, bal) <- dayitems
          $# data-account and data-kind are for an instance stylesheet, to give
          $# the row an icon (see the manual's "Customising the look").
          <tr ##{transactionFrag torig} data-entry="#{showTransaction torig}"
              data-account="#{mainAccount torig}" data-kind="#{entryKindClass (esKind (summary torig))}">
            <td .date nowrap>
              <a href="@?{(JournalR, [("q", journalDayQuery qparam (tdate torig))])}##{transactionFrag torig}"
                 title=_{HMsg "Show this entry and the other journal entries on its date"}>
                #{show (tdate tacct)}
            <td .description>
              $if elem AddPermission perms
                <a .entry-edit href=@{TransactionR (tindex torig)} title=_{HMsg "Edit this entry"} aria-label=_{HMsg "Edit this entry"}>
                  <span .glyphicon .glyphicon-pencil aria-hidden="true">
              #{textElideRight 30 (tdescription tacct)}
            <td .account>
              $forall (acc, comma) <- otherTransAccounts torig
                <a href="@?{acctlink acc torig}##{transactionFrag torig}" title="#{acc}">
                  ^{accountNameAsHtml acc}</a>#{comma}
            <td .amount>
              $if not split || not (mixedAmountLooksZero amt)
                ^{mixedAmountAsHtml amt}
            <td .amount.balance>
              ^{mixedAmountAsHtml bal}
            $# On a phone, the row is shown as this block instead (hledger.css
            $# section 17): the account the entry is mainly about and the
            $# amount, red when it left this account and green when it came in;
            $# the payee and note; and the balance after it.
            <td .entry-card colspan=5>
              <span .entry-icon>
              <span .entry-what>
                <a href="@?{acctlink (mainAccount torig) torig}##{transactionFrag torig}" title="#{mainAccount torig}">
                  ^{accountNameAsHtml (mainAccount torig)}
              <span .entry-amount :isNegative amt:.spending :isPositive amt:.earning>
                $if not split || not (mixedAmountLooksZero amt)
                  #{oneLine amt}
              <span .entry-memo>#{payeeAndNote torig}
              <span .entry-balance>
                <span .sr-only>_{HMsg "Balance after this entry:"}
                <span aria-hidden="true">» #
                #{oneLine (runningBalance bal)}
              $if elem AddPermission perms
                <a .entry-edit href=@{TransactionR (tindex torig)} title=_{HMsg "Edit this entry"} aria-label=_{HMsg "Edit this entry"}>
                  <span .glyphicon .glyphicon-pencil aria-hidden="true">
      $if historical && lastpage
        $maybe start <- mstart
          <tr .broughtforward>
            <td .date nowrap>
              #{show (snd start)}
            <td .description>
              _{HMsg "Balance brought forward"}
            <td .account>
            <td .amount>
            <td .amount.balance>
              $if mixedAmountLooksZero startbal
                ^{mixedAmountAsHtml startbal}
              $else
                <a href=@?{broughtForwardLink start} title=_{HMsg "Show the transactions before this period"}>
                  ^{mixedAmountAsHtml startbal}

^{pagingLinks trs RegisterR qparam page}

$if elem AddPermission perms
  ^{addModal AddR j today}
