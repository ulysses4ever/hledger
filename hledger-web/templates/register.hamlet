<h2>
  #{header}

^{periodBand trs RegisterR qparam accumParams shown noBelow}

^{yearsRow trs RegisterR qparam yearParams (isAllTime shown) years}
^{pagingLinks trs RegisterR qparam page}

<div>
  ^{registerChartHtml qparam accumParams transactionFrag (T.unpack balancelabel) $ accountTransactionsReportByCommodity items}

<div.table-responsive>
  <table .registerreport.table.table-condensed>
    <thead>
      <tr>
        <th>
          _{HMsgc "column heading" "Date"}
          <span .glyphicon.glyphicon-chevron-up>
        <th>_{HMsgc "column heading" "Description"}
        <th>_{HMsgc "column heading" "To/From Account(s)"}
        <th .amount>_{HMsgc "column heading" "Amount Out/In"}
        <th .amount.balance>
          <a href=@?{accumToggle} title="#{accumToggleTitle}">#{balancelabel}

    <tbody>
      $forall (torig, tacct, split, _acct, amt, bal) <- items
        $# data-account and data-kind are for an instance stylesheet, to give
        $# the row an icon (see the manual's "Customising the look").
        <tr ##{transactionFrag torig} data-entry="#{showTransaction torig}"
            data-account="#{mainAccount torig}" data-kind="#{entryKindClass (esKind (summary torig))}">
          <td .date nowrap>
            <a href="@?{(JournalR, [("q", journalDayQuery qparam (tdate torig))])}##{transactionFrag torig}"
               title=_{HMsg "Show this entry and the other journal entries on its date"}>
              #{show (tdate tacct)}
          <td .description>
            #{textElideRight 30 (tdescription tacct)}
          <td .account>
            $forall (acc, comma) <- otherTransAccounts torig
              <a href="@?{acctlink acc torig}##{transactionFrag torig}" title="#{acc}">
                ^{accountNameAsHtml acc}</a>#{comma}
          <td .amount>
            $if not split || not (mixedAmountLooksZero amt)
              ^{mixedAmountAsHtml amt}
          <td .amount.balance>
            ^{mixedAmountAsHtml bal}
      $if historical && lastpage
        $maybe start <- mstart
          <tr .broughtforward>
            <td .date nowrap>
              #{show (snd start)}
            <td .description>
              _{HMsg "Balance brought forward"}
            <td .account>
            <td .amount>
            <td .amount.balance>
              $if mixedAmountLooksZero startbal
                ^{mixedAmountAsHtml startbal}
              $else
                <a href=@?{broughtForwardLink start} title=_{HMsg "Show the transactions before this period"}>
                  ^{mixedAmountAsHtml startbal}

^{pagingLinks trs RegisterR qparam page}

$if elem AddPermission perms
  ^{addModal AddR j today}
